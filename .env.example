# Alecis-v3 environment
PORT=3551
SSL_PORT=443
XMPP_PORT=80
XMPP_WSS_PORT=4433
MATCHMAKER_PORT=8081
CALDERA_PORT=5000

# Optional: MongoDB for persistent storage. If not running, backend uses in-memory storage (resets on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/alecis_v3
JWT_SECRET=change-this-secret


# Discord Bot
DISCORD_BOT_ENABLED=false
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
DISCORD_MOD_ROLE_ID=

# Features
DEFAULT_SEASON=12
BATTLEPASS_SEASON=12
ENABLE_AUTO_SHOP=true
ENABLE_SSL=false
ENABLE_HTTPS=false

# V-Bucks/Kill/Win API key (used by game servers to report events)
GAME_API_KEY=change-this-api-key

# Gameserver defaults
GAMESERVER_IP=127.0.0.1
GAMESERVER_PORT=7777
GAMESERVER_PLAYLIST=Playlist_DefaultSolo

# SAC
SAC_VBUCKS_REWARD=5
SAC_CREATOR_CUT_PERCENT=5
